// ============================================================
// Watermark.gs — Asset & Helper Watermark "AMSP BENGKEL"
// ============================================================
var WATERMARK_AMSP_BENGKEL_BASE64 = "";

function getWatermarkBlob() {
  try {
    return Utilities.newBlob(
      Utilities.base64Decode(WATERMARK_AMSP_BENGKEL_BASE64),
      "image/png",
      "watermark_amsp_bengkel.png"
    );
  } catch (e) {
    Logger.log("Error getWatermarkBlob: " + e.toString());
    return null;
  }
}
